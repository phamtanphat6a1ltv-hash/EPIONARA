# =====================================================
# Soulmate Journal - Environment Variables (EXAMPLE FILE)
# =====================================================
# NEVER commit the actual .env file to version control!
# Copy this file to .env and fill in your values.

# ------- VERCEL DEPLOYMENT (server-side, KHÔNG bị bundle vào client) -------
# Đặt key này trong Vercel Dashboard > Project Settings > Environment Variables
# KHÔNG dùng prefix VITE_ — key này chỉ tồn tại trên server
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ------- LOCAL DEV (optional) -------
# Nếu test local mà không có proxy, user có thể nhập key trong app settings.
# KHÔNG cần VITE_GEMINI_API_KEY nữa — key đã được proxy qua /api/gemini.
