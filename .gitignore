# =====================================================
# Soulmate Journal - .gitignore
# =====================================================

# Environment files - NEVER commit these
.env
.env.local
.env.production
.env.staging

# Dependencies
node_modules/

# Build output
dist/

# Editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Cache
.cache/
